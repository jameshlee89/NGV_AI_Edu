[MASTER]
ignore=WP_Templates,OEM_Sample

[MESSAGES CONTROL]
# CLAUDE.md 구현 지침이 요구하는 지표만 게이트로 사용한다:
# - invalid-name: 네이밍 규칙(3글자 이상, camelCase) 확인 (아래 [BASIC] 참고)
# - too-many-statements: 함수 순수코드 라인수(50줄 이하)의 근사 지표
# - duplicate-code: 중복 코드(7줄까지 허용) 확인
disable=all
enable=invalid-name,too-many-statements,duplicate-code

[BASIC]
# tdd 스킬 references/naming-convention.md와 동일한 규칙:
# 3글자 이상, 소문자로 시작하는 camelCase. 메서드는 매직 메서드(__init__ 등, 언어 규약)를 예외로 허용.
# attr-rgx/class-attribute-rgx를 빠뜨리면 인스턴스 속성명이 pylint 기본값(snake_case)과
# 충돌해 개별 파일에서 국소적으로 invalid-name을 꺼야 하는 상황이 생기므로 반드시 함께 지정한다.
# 선행 언더스코어 1개(`_camelCase`)는 Python의 "내부 전용" 관례이므로 모든 패턴에서 선택적으로
# 허용한다(언더스코어 뒤 이름 부분은 여전히 3글자 이상 camelCase여야 함) — VJ-ECL-2026 Phase 1 구현
# 중 실측으로 발견된 간극을 반영해 2026-09-18 수정.
function-rgx=_?[a-z][a-zA-Z0-9]{2,}$
variable-rgx=_?[a-z][a-zA-Z0-9]{2,}$
argument-rgx=_?[a-z][a-zA-Z0-9]{2,}$
method-rgx=(__[a-z][a-zA-Z0-9]*__|_?[a-z][a-zA-Z0-9]{2,})$
attr-rgx=_?[a-z][a-zA-Z0-9]{2,}$
class-attribute-rgx=_?[a-z][a-zA-Z0-9]{2,}$

[DESIGN]
# "함수 라인수는 순수코드라인 50라인 이하" 근사 지표로 statement 수를 사용한다.
max-statements=50

[SIMILARITIES]
# 8줄 이상 중복만 위반으로 간주 (7줄까지는 허용)
min-similarity-lines=8
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
